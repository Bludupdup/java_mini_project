# Copy this file to .env.local (same folder) and fill in your own values.
# .env.local is gitignored, so your password never ends up on GitHub.
DB_URL=jdbc:postgresql://localhost:5432/codepath_learning
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
